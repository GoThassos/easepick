{
  "compilerOptions": {
    "outDir": "dist",
    "module": "esnext",
    "target": "esnext",
    "moduleResolution": "bundler",
    "strict": false,
    "noUncheckedSideEffectImports": false,
    "esModuleInterop": true,
    "emitDeclarationOnly": true,
    "composite": true,
    "paths": {
      "@gothassos/*": [
        "./packages/*/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "**/node_modules/*",
    "__tests__",
    "docs"
  ],
  "references": [
    {
      "path": "packages/core"
    },
    {
      "path": "packages/datetime"
    },
    {
      "path": "packages/base-plugin"
    },
    {
      "path": "packages/lock-plugin"
    },
    {
      "path": "packages/preset-plugin"
    },
    {
      "path": "packages/range-plugin"
    },
    {
      "path": "packages/time-plugin"
    },
    {
      "path": "packages/kbd-plugin"
    },
    {
      "path": "packages/amp-plugin"
    },
    {
      "path": "packages/sample-plugin"
    },
    {
      "path": "packages/mselect-plugin"
    },
  ]
}
